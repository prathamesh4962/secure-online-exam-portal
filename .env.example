DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,testserver
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is the default local development database. For PostgreSQL, set DATABASE_URL.
# To use MySQL instead, set DB_ENGINE=mysql and configure the values below.
DB_ENGINE=sqlite
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=secure_exam_portal
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
